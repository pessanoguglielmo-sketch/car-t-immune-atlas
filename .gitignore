# Data (too large / re-downloadable — never commit raw or processed data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Figures (regenerated by the pipeline; keep repo light)
figures/*
!figures/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.venv/
env/

# OS
.DS_Store

# Env
.env
